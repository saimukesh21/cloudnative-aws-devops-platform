pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AWS Credential Test') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-jenkins-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    withEnv([
                        'AWS_DEFAULT_REGION=ap-south-1',
                        'AWS_REGION=ap-south-1',
                        'AWS_EC2_METADATA_DISABLED=true'
                    ]) {
                        bat '"C:/Program Files/Amazon/AWSCLIV2/aws.exe" sts get-caller-identity'
                    }
                }
            }
        }
        stage('Build') {
            steps {
                dir('application') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('application') {
                    bat 'mvn -B -ntp -DforkCount=0 test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube code quality analysis...'

                withSonarQubeEnv('SonarQube') {
                    dir('application') {
                        bat 'mvn sonar:sonar -Dsonar.projectKey=cloudnative-aws-devops-platform -Dsonar.projectName=CloudNative-AWS-DevOps-Platform'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image...'
                bat 'docker build -f docker\\Dockerfile -t product-api:%BUILD_NUMBER% .'
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo 'Scanning Docker image for HIGH and CRITICAL vulnerabilities...'

                bat 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ aquasec/trivy:0.76.2 image --scanners vuln --severity HIGH,CRITICAL --exit-code 1 product-api:%BUILD_NUMBER%'
            }
        }

        stage('ECR Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-jenkins-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    withEnv([
                        'AWS_DEFAULT_REGION=ap-south-1',
                        'AWS_REGION=ap-south-1',
                        'AWS_EC2_METADATA_DISABLED=true'
                    ]) {
                        bat '''
@echo off
"C:/Program Files/Amazon/AWSCLIV2/aws.exe" ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 396288590846.dkr.ecr.ap-south-1.amazonaws.com
if errorlevel 1 exit /b 1

docker tag product-api:%BUILD_NUMBER% 396288590846.dkr.ecr.ap-south-1.amazonaws.com/product-api:%BUILD_NUMBER%
if errorlevel 1 exit /b 1

docker push 396288590846.dkr.ecr.ap-south-1.amazonaws.com/product-api:%BUILD_NUMBER%
if errorlevel 1 exit /b 1

docker logout 396288590846.dkr.ecr.ap-south-1.amazonaws.com
'''
                    }
                }
            }
        }
        stage('Docker Verify') {
            steps {
                bat 'docker images product-api'
            }
        }
    }

    post {
        always {
            junit testResults: 'application/target/surefire-reports/*.xml',
                  allowEmptyResults: true

            archiveArtifacts artifacts: 'application/target/*.jar',
                             allowEmptyArchive: false
        }

        success {
            echo 'SUCCESS: Build, tests, SonarQube Quality Gate, Docker image and Trivy security scan completed!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
